{
  "name": "yaml-language-server",
  "languageId": "yaml",
  "command": [
    "yaml-language-server",
    "--stdio"
  ],
  "settings": {
    "yaml": {
      "format": {
        "enable": true,
        "singleQuote": true,
        "bracketSpacing": true,
        "proseWrap": "preserve",
        "printWidth": 120
      },
      "validate": true,
      "hover": true,
      "completion": true,
      "schemaStore": {
        "enable": true,
        "url": "https://www.schemastore.org/api/json/catalog.json"
      },
      "maxItemsComputed": 5000
    }
  }
}
